# Salin ke ".env" DI SERVER (jangan di-commit). Satu variabel per baris, tanpa spasi di sekitar "=", tanpa tanda kutip.
# Bila mengetik di Windows lalu menyalin ke server, hapus CR:  sed -i 's/\r$//' .env

# Alamat publik (tanpa https://). Record DNS A untuk host ini harus sudah mengarah ke IP VPS sebelum Caddy dijalankan.
DOMAIN=vendoria.wilantara.me

# Password database (buat baru & acak, JANGAN pakai password lokal):  openssl rand -base64 24 | tr -d '=+/'
DB_PASSWORD=

# Email OTP (Resend). Nama variabelnya memang "Resend" (huruf besar R).
Resend=
# Bawaan (onboarding@resend.dev) hanya bisa mengirim ke email pemilik akun Resend. Agar bisa ke email siapa pun:
# verifikasi domain wilantara.me di Resend (tambahkan record DNS yang diminta), lalu isi:
# RESEND_FROM=Vendoria <noreply@wilantara.me>

# Login Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Midtrans SANDBOX (kunci berawalan "SB-"). Biarkan MIDTRANS_IS_PRODUCTION=false walau aplikasi sudah online:
# "production" di sini berarti Midtrans produksi (uang asli); pada mode itu pelunasan otomatis sengaja dimatikan.
MIDTRANS_SERVER_KEY=
MIDTRANS_SIGNATURE_SECRET_KEY=
MIDTRANS_IS_PRODUCTION=false
# Sandbox saja: backend melunasi VA BCA sendiri lewat simulator, jadi demo tak perlu bayar manual.
MIDTRANS_SANDBOX_AUTO_CONFIRM=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin pertama, dibuat otomatis saat backend start HANYA bila belum ada admin sama sekali (password 8-72 karakter).
# Bila akun ber-email ini sudah terdaftar, akun itu dinaikkan jadi admin (password-nya tak diubah).
# Setelah login admin berhasil, HAPUS kedua baris ini dari .env lalu: docker compose up -d
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
